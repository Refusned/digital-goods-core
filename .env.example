# Порт основного API
PORT=3010
# Порты заглушек-поставщиков (поднимаются тем же процессом, но как отдельные HTTP-сервисы)
SUPPLIER_A_PORT=3121
SUPPLIER_B_PORT=3122

DATABASE_URL=postgres://shop:shop@localhost:5442/shop

# Поведение клиента поставщиков
SUPPLIER_TIMEOUT_MS=1500
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_BASE_MS=200

# Доля сбоев заглушек (0..1). Для воспроизводимых сценариев меняются на лету через POST /_chaos
SUPPLIER_A_ERROR_RATE=0
SUPPLIER_A_TIMEOUT_RATE=0
SUPPLIER_B_ERROR_RATE=0
SUPPLIER_B_TIMEOUT_RATE=0

# Фоновый воркер восстановления
WORKER_ENABLED=1
WORKER_INTERVAL_MS=1000
OUT_OF_STOCK_RETRY_MS=5000

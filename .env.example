# Порт основного API
PORT=3010
# Порты заглушек-поставщиков (поднимаются тем же процессом, но как отдельные HTTP-сервисы)
SUPPLIER_A_PORT=3121
SUPPLIER_B_PORT=3122

DATABASE_URL=postgres://shop:shop@localhost:5442/shop

# Поведение клиента поставщиков
SUPPLIER_TIMEOUT_MS=1500
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_BASE_MS=200

# Доля сбоев заглушек (0..1). Для воспроизводимых сценариев меняются на лету через POST /_chaos
SUPPLIER_A_ERROR_RATE=0
SUPPLIER_A_TIMEOUT_RATE=0
SUPPLIER_B_ERROR_RATE=0
SUPPLIER_B_TIMEOUT_RATE=0

# Фоновый воркер восстановления
WORKER_ENABLED=1
WORKER_INTERVAL_MS=1000
OUT_OF_STOCK_RETRY_MS=5000

# --- Второй этап -------------------------------------------------------------
# Заглушка платёжного шлюза: через неё уходят возвраты за невыданные позиции
PAYMENT_STUB_PORT=3131
PAYMENT_TIMEOUT_MS=1500

# Сколько позиция вправе ждать код, прежде чем её объявят невыдаваемой и вернут деньги
DELIVERY_DEADLINE_MS=120000
DELIVERY_MAX_ITEM_ATTEMPTS=8
# Сколько раз подряд разрешено просить у поставщика замену негодного кода
DELIVERY_MAX_CODE_REJECTIONS=3
DELIVERY_BATCH_SIZE=40
DELIVERY_CONCURRENCY=8

# Возвраты
REFUND_MAX_ATTEMPTS=20
REFUND_RETRY_MS=2000

# Лимит запросов к поставщику (договорный). Меняется на ходу через
# POST /admin/suppliers/:name/rate-limit
SUPPLIER_RATE_LIMIT_ENABLED=1
SUPPLIER_RATE_CAPACITY=60
SUPPLIER_RATE_WINDOW_MS=60000

# Фоновая сверка журнала поставщика со своими выдачами
SUPPLIER_RECONCILER_ENABLED=1
SUPPLIER_RECONCILER_INTERVAL_MS=2000
